# Copy to .env and fill in only the providers you use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Bedrock uses your normal AWS credentials/profile (AWS_PROFILE, AWS_REGION).
AWS_REGION=eu-central-1
# Llama runs locally through Ollama (https://ollama.com): `ollama pull llama3.1`

# Optional LangSmith tracing: every graph run shows up as a trace.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=triage-agent

# Decisions below this confidence pause for human review (0-1).
TRIAGE_REVIEW_THRESHOLD=0.7
